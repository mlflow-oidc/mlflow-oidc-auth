{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./auth.db)",
      "Read(./mlflow.db)",
      "Read(./test.db)",
      "Read(./**/*.sqlite)",
      "Read(./**/*.sqlite3)",
      "Read(//Users/**/.ssh/**)",
      "Read(//Users/**/.aws/**)",
      "Read(//Users/**/.kube/config)",
      "Read(//Users/**/.docker/config.json)",
      "Read(//Users/**/.netrc)",
      "Read(//Users/**/.npmrc)",
      "Read(//Users/**/.pypirc)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(curl:* -d *)",
      "Bash(curl:* --data*)",
      "Bash(gh secret:*)",
      "Bash(gh auth token:*)",
      "Bash(env)",
      "Bash(printenv:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)",
      "Bash(gh release:*)",
      "Bash(pip install:*)",
      "Bash(yarn add:*)",
      "Bash(npm install:*)",
      "Write(./.github/workflows/**)",
      "Edit(./.github/workflows/**)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/settings.json)"
    ],
    "allow": [
      "Bash(pytest:*)",
      "Bash(tox:*)",
      "Bash(black:*)",
      "Bash(pre-commit run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(yarn test:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn build:*)"
    ]
  }
}
